---
interface Props {
    src: string;
    alt: string;
    size?: string;
}

const { src, alt, size = '150px' } = Astro.props;
---

<div class="circle-image" style={`--size: ${size}`}>
    <img src={src} alt={alt} />
</div>

<style>
    .circle-image {
        width: var(--size);
        height: var(--size);
        border-radius: 50%;
        overflow: hidden;
        display: inline-block;
    }

    .circle-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
</style>