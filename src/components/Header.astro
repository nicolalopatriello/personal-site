---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
    <nav>
        <h2>nicolalopatriello.com</h2>
        <div class="internal-links">
            <HeaderLink href="/">About</HeaderLink>
            <HeaderLink href="/blog">Blog</HeaderLink>
        </div>
        <div class="social-links">
            <h2>
                <a href="https://github.com/nicolalopatriello" target="_blank">
                    <span class="sr-only">GitHub personal page</span>
                    <svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
                    ><path
                            fill="currentColor"
                            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                    ></path></svg
                    >
                </a>

                <a href="/rss.xml" target="_blank">
                    <span class="sr-only">RSS Feed</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32">
                        <path
                                fill="currentColor"
                                d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"
                        ></path>
                        <path
                                fill="currentColor"
                                d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"
                        ></path>
                        <circle cx="6" cy="18" r="2" fill="currentColor"></circle>
                    </svg>
                </a>

            </h2>
        </div>
    </nav>
</header>
<style>
    header {
        margin: 0;
        padding: 0 1em;
        background: white;
        box-shadow: 0 2px 8px rgba(var(--black), 5%);
    }
    h2 {
        margin: 0;
        font-size: 1em;
    }

    h2 a,
    h2 a.active {
        text-decoration: none;
    }
    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    nav > * {
        flex: 1;
    }
    nav > h2:first-child {
        text-align: left;
    }
    .internal-links {
        display: flex;
        justify-content: center;
        gap: 0.5em;
    }
    .social-links {
        display: flex;
        flex-direction: row;
        justify-content: flex-end;
    }

    .social-links h2 {
        display: flex;
    }
    nav a {
        padding: 1em 0.5em;
        color: var(--black);
        border-bottom: 4px solid transparent;
        text-decoration: none;
    }
    nav a.active {
        text-decoration: none;
        border-bottom-color: var(--accent);
    }
    .social-links a {
        display: flex;
    }
    @media (max-width: 720px) {
        .social-links {
            display: none;
        }
        nav > * {
            flex: unset;
        }
        nav > h2:first-child {
            flex: 0;
        }
        .internal-links {
            flex: 1;
        }
    }
</style>